# Render #2 — HEAVY worker — R14
# Internal numeric/tuning values are packaged in runtime_config.py.
# Keep only credentials, remote addresses and external resource identifiers here.

# Peer addresses
FRONT_SERVICE_URL=https://fo-ug7k.onrender.com
PEER_SERVICE_URL=https://fo-ug7k.onrender.com
PEER_SHARED_SECRET=<SAME_LONG_SECRET_AS_RENDER1>

# Shared Redis address/credentials
REDIS_URL=<SAME_CURRENT_REDIS_URL_AS_RENDER1>

# MEGA credentials / remote paths
MEGA_EMAIL=<CURRENT_MEGA_EMAIL>
MEGA_PASSWORD=<CURRENT_MEGA_PASSWORD>
MEGA_SESSION=
MEGA_BACKUP_DIR=/TelegramBotBackups
MEGA_LEGACY_BACKUP_DIRS=/TelegramBotBackups2-2,/TelegramBotBackups-2T

# Google service-account secret and optional external target ID
GOOGLE_SERVICE_ACCOUNT_JSON=<PASTE_YOUR_EXISTING_SERVICE_ACCOUNT_JSON>
GOOGLE_SHEETS_SPREADSHEET_ID=

# DO NOT SET tuning values such as intervals, limits, ports or on/off flags.
# They are authoritative in runtime_config.py.

# v263: optional hard startup isolation: normal | local_lab | safe_isolation
# Leave unset to use persisted owner profile; set only for a boot hard override.
# EXTERNAL_IO_BOOT_MODE=normal
# v263 hard boot overrides. Leave unset for persisted owner-selected state.
# EXTERNAL_IO_BOOT_MODE=local_lab
# STORAGE_POLICY_BOOT_MODE=auto

