# Render #2 — HEAVY worker
PORT=10000
FRONT_SERVICE_URL=https://fo-ug7k.onrender.com
PEER_SERVICE_URL=https://fo-ug7k.onrender.com
PEER_SHARED_SECRET=<SAME_LONG_SECRET_AS_RENDER1>

# SAME Render Redis/Key Value on BOTH services
REDIS_URL=<CURRENT_REDIS_URL>
WORKER_REDIS_SNAPSHOT_KEY=vys262:bot_state:latest_gz
WORKER_REDIS_SNAPSHOT_MAX_MB=16

# MEGA durability/archive
MEGA_EMAIL=<CURRENT_MEGA_EMAIL>
MEGA_PASSWORD=<CURRENT_MEGA_PASSWORD>
MEGA_SESSION=
MEGA_BACKUP_DIR=/TelegramBotBackups2-2
MEGA_LEGACY_BACKUP_DIRS=/TelegramBotBackups-2T,/TelegramBotBackups
MEGA_TIMEOUT=180
MEGA_LOGIN_TIMEOUT=120
WORKER_CACHE_DIR=/tmp/vys262_worker
WORKER_FRONT_FETCH_TIMEOUT=30
WORKER_RESTORE_CACHE_MAX_AGE_SEC=120
WORKER_HISTORY_INTERVAL_SEC=3600
WORKER_SNAPSHOT_UPLOAD_MAX_MB=64

# Google Sheets — service account is ONLY here
GOOGLE_SERVICE_ACCOUNT_JSON=<PASTE_YOUR_EXISTING_SERVICE_ACCOUNT_JSON>
GOOGLE_SHEETS_SPREADSHEET_ID=
